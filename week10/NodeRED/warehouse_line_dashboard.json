    "type": "function",
    "z": "a1e0000000000001",
    "name": "Report to widgets",
    "func": "// Coordinator report -> the three report widgets (output 1) and the two selectors (outputs 2 and 3)\nconst r = msg.payload;\nif (typeof r !== 'object') return null;\nif (r.coordinator !== 'online') return [msg, null, null];\nreturn [msg, { payload: 'target_' + r.target }, { payload: 'mode_' + r.mode }];",
    "outputs": 3,
