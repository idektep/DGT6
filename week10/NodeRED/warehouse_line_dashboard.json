  {
    "id": "a1e0000000000044",
    "type": "ui-template",
    "z": "a1e0000000000001",
    "group": "a1e0000000000008",
    "page": "",
    "ui": "",
    "name": "Activity log",
    "order": 1,
    "width": "6",
    "height": "7",
    "head": "",
    "format": "<template>\n  <div class=\"wl-log log\">\n    <div v-for=\"(e, i) in entries\" :key=\"i\" :class=\"['row', e.level]\">\n      <span class=\"t\">{{ e.time }}</span>\n      <span :class=\"['src', e.source]\">{{ e.source }}</span>\n      <span class=\"txt\">{{ e.text }}</span>\n    </div>\n    <div v-if=\"!entries.length\" class=\"hint\">No activity yet.</div>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    entries () { return (this.msg && this.msg.payload && this.msg.payload.log) || [] }\n  }\n}\n</script>\n\n<style>\n.wl-log .log { max-height: 300px; overflow-y: auto; font-size: 13px; }\n.wl-log .row { display: flex; gap: 10px; align-items: baseline; padding: 7px 2px; border-bottom: 1px solid #f0f2f1; }\n.wl-log .t { color: #a3ada7; font-variant-numeric: tabular-nums; font-size: 12px; }\n.wl-log .src { min-width: 92px; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; padding: 2px 8px; border-radius: 999px;\n       text-align: center; background: #eef1ef; color: #5d6b64; }\n.wl-log .src.SIM { background: #fdf0d9; color: #b7791f; }\n.wl-log .src.REAL { background: #e9e4f5; color: #5b4a8b; }\n.wl-log .src.USER { background: #d7ebe2; color: #2f7a5c; }\n.wl-log .txt { flex: 1; }\n.wl-log .row.ok .txt { color: #2f7a5c; }\n.wl-log .row.warn .txt { color: #b7791f; }\n.wl-log .row.error .txt { color: #c0392b; font-weight: 600; }\n.wl-log .hint { color: #8a968f; padding: 6px 0; }\n</style>",
