    "head": "",
    "format": "<template>\n  <div class=\"wl-sim\">\n  <div v-if=\"!s\" class=\"hint\">Waiting for Unity (through the coordinator): press Play in the W07_Shelf_Standalone scene.</div>\n  <div v-else>\n    <div class=\"head\">\n      <span :class=\"['phase', s.phase]\">{{ s.phase }}</span>\n      <span class=\"stamp\">updated {{ s.timestamp }}</span>\n    </div>\n    <div class=\"steps\">\n      <div v-for=\"(name, i) in s.steps\" :key=\"i\" :class=\"['step', status(i + 1)]\">\n        <span class=\"num\">{{ i + 1 }}</span>\n        <span class=\"name\">{{ name }}</span>\n        <span class=\"time\" v-if=\"s.stepSeconds[i] > 0\">{{ s.stepSeconds[i].toFixed(1) }} s</span>\n      </div>\n    </div>\n    <div class=\"state\">{{ s.state }}</div>\n  </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    s () { return (this.msg && this.msg.payload && this.msg.payload.sim) || null }\n  },\n  methods: {\n    status (n) {\n      const p = this.s\n      // idle with a step number = the whole cycle has finished\n      if (n < p.step || (n === p.step && (p.phase === 'done' || p.phase === 'idle'))) return 'done'\n      if (n === p.step && p.phase === 'running') return 'running'\n      if (n === p.step && p.phase === 'waiting') return 'waiting'\n      return 'pending'\n    }\n  }\n}\n</script>\n\n<style>\n.wl-sim .hint { color: #8a968f; padding: 8px 0; }\n.wl-sim .head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }\n.wl-sim .phase { padding: 3px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; text-transform: uppercase;\n         background: #e4e9e6; color: #6f7c75; }\n.wl-sim .phase.running { background: #fdf0d9; color: #b7791f; }\n.wl-sim .phase.waiting { background: #d7ebe2; color: #2f7a5c; }\n.wl-sim .phase.done { background: #2f7a5c; color: #fff; }\n.wl-sim .phase.resetting { background: #e9e4f5; color: #5b4a8b; }\n.wl-sim .phase.offline { background: #fbe3df; color: #c0392b; }\n.wl-sim .stamp { margin-left: auto; font-size: 12px; color: #a3ada7; }\n.wl-sim .steps { display: flex; flex-direction: column; gap: 6px; }\n.wl-sim .step { display: flex; align-items: center; gap: 12px; padding: 9px 12px; border-radius: 10px; background: #f5f7f6; color: #6f7c75; }\n.wl-sim .num { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 700;\n       background: #e4e9e6; color: #6f7c75; }\n.wl-sim .name { flex: 1; }\n.wl-sim .time { font-size: 12px; font-variant-numeric: tabular-nums; }\n.wl-sim .step.done { background: #e8f4ee; color: #24332c; }\n.wl-sim .step.done .num { background: #2f7a5c; color: #fff; }\n.wl-sim .step.running { background: #fdf0d9; color: #24332c; font-weight: 600; }\n.wl-sim .step.running .num { background: #f2a93b; color: #fff; }\n.wl-sim .step.waiting { background: #fff; color: #24332c; box-shadow: inset 0 0 0 2px #d7ebe2; font-weight: 600; }\n.wl-sim .step.waiting .num { background: #d7ebe2; color: #2f7a5c; }\n.wl-sim .state { margin-top: 12px; font-size: 13px; color: #5d6b64; }\n</style>",
