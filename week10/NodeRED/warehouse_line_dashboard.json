  {
    "id": "a1e0000000000042",
    "type": "ui-template",
    "z": "a1e0000000000001",
    "group": "a1e0000000000003",
    "page": "",
    "ui": "",
    "name": "Status",
    "order": 1,
    "width": "4",
    "height": "3",
    "head": "",
    "format": "<template>\n  <div class=\"wl-status status\">\n    <div class=\"row\">\n      <span :class=\"['dot', online ? 'on' : 'off']\"></span>\n      <span class=\"label\">{{ online ? 'Coordinator online' : 'Coordinator offline' }}</span>\n      <span v-if=\"online\" class=\"sub\">{{ r.target === 'both' ? 'Sim + real world' : 'Sim only' }} &middot; {{ r.mode === 'full' ? 'Full loop' : 'Step-by-step' }}</span>\n    </div>\n    <div v-if=\"online && r.sim\" class=\"shelf\">Shelf <b>{{ r.sim.shelfStored }}</b> / {{ r.sim.shelfCapacity }} boxes</div>\n    <div v-if=\"online\" class=\"waiting\">\n      <div class=\"caption\">Waiting for</div>\n      <div :class=\"['pill', r.waitingFor]\">{{ waitingText }}</div>\n    </div>\n    <div v-else class=\"hint\">Start it with <code>python main.py</code></div>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    r () { return (this.msg && this.msg.payload) || {} },\n    online () { return this.r.coordinator === 'online' },\n    waitingText () {\n      const p = this.r\n      return {\n        start: 'You: press Start',\n        sim: 'Simulation, step ' + p.step,\n        real: 'Real world, step ' + p.step,\n        user: 'You: press Next for step ' + (p.step + 1),\n        error: p.step <= 4 ? 'You: Retry step or Reset' : 'You: Retry step',\n      }[p.waitingFor]\n    }\n  }\n}\n</script>\n\n<style>\n.wl-status .status { display: flex; flex-direction: column; gap: 10px; }\n.wl-status .row { display: flex; align-items: center; gap: 8px; }\n.wl-status .dot { width: 9px; height: 9px; border-radius: 50%; background: #c9cfcb; }\n.wl-status .dot.on { background: #3fb27f; box-shadow: 0 0 0 3px #d7ebe2; }\n.wl-status .dot.off { background: #e07a6a; box-shadow: 0 0 0 3px #f8e1dc; }\n.wl-status .label { font-weight: 600; }\n.wl-status .sub { margin-left: auto; color: #8a968f; font-size: 13px; }\n.wl-status .caption { font-size: 12px; color: #8a968f; margin-bottom: 4px; }\n.wl-status .pill { display: inline-block; padding: 6px 14px; border-radius: 999px; font-weight: 600; font-size: 14px; background: #d7ebe2; color: #2f7a5c; }\n.wl-status .pill.sim { background: #fdf0d9; color: #b7791f; }\n.wl-status .pill.real { background: #e9e4f5; color: #5b4a8b; }\n.wl-status .pill.error { background: #fbe3df; color: #c0392b; }\n.wl-status .shelf { font-size: 13px; color: #5d6b64; }\n.wl-status .hint { color: #8a968f; font-size: 13px; }\n.wl-status code { background: #eef1ef; padding: 1px 6px; border-radius: 6px; }\n</style>",
