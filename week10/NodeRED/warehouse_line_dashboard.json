    "name": "Page style",
    "order": 0,
    "width": 0,
    "height": 0,
    "head": "",
    "format": "/* Warehouse Line: minimal green style */\n.v-application { font-family: \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif; color: #24332c; }\n.v-app-bar { background: #2f7a5c !important; color: #fff !important; box-shadow: none !important; }\n.v-app-bar .v-toolbar-title, .v-app-bar .v-btn { color: #fff !important; }\n.v-navigation-drawer { background: #2f7a5c !important; color: #e8f3ee !important; border: none !important; }\n.v-navigation-drawer .v-list-item { color: #e8f3ee !important; border-radius: 10px; margin: 2px 10px; }\n.v-navigation-drawer .v-list-item--active { background: rgba(255, 255, 255, 0.16) !important; color: #fff !important; }\n.v-navigation-drawer .v-list-item--active .v-list-item__overlay { opacity: 0 !important; }\n.nrdb-ui-group > .v-card { border: none !important; box-shadow: 0 1px 3px rgba(36, 51, 44, 0.06) !important; }\n.nrdb-ui-group .v-card-title, .nrdb-ui-group h4 { font-weight: 600 !important; font-size: 15px !important; color: #24332c; }\n.nrdb-ui-button .v-btn { border-radius: 999px !important; text-transform: none !important; letter-spacing: 0 !important;\n  box-shadow: none !important; font-weight: 600 !important; }\n.nrdb-ui-radio-group label, .nrdb-ui-radio-group .v-label { font-size: 14px; }\n",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
