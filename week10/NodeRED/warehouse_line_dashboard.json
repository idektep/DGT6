  {
    "id": "a1e0000000000043",
    "type": "ui-template",
    "z": "a1e0000000000001",
    "group": "a1e0000000000006",
    "page": "",
    "ui": "",
    "name": "Real-world steps",
    "order": 1,
    "width": "6",
    "height": "5",
    "head": "",
    "format": "<template>\n  <div class=\"wl-real\">\n    <div class=\"tiles\">\n      <div v-for=\"(action, i) in actions\" :key=\"i\" :class=\"['tile', state(i)]\">\n        <div class=\"num\">{{ i + 1 }}</div>\n        <div class=\"act\">{{ action.split('_').join(' ') }}</div>\n        <div class=\"st\">{{ state(i) }}</div>\n      </div>\n    </div>\n    <div class=\"note\">{{ note }}</div>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    r () { return (this.msg && this.msg.payload) || {} },\n    actions () { return this.r.actions || ['conveyor_to_arm2', 'arm2_pick', 'arm2_place_on_agv', 'agv_to_arm1',\n      'arm1_pick', 'arm1_place_on_cartesian', 'cartesian_store', 'agv_cartesian_home'] },\n    note () {\n      if (this.r.coordinator !== 'online') return 'Coordinator offline'\n      return this.r.target === 'both' ? 'Each step runs here after the simulation finishes it' : 'Not used: target is simulation only'\n    }\n  },\n  methods: {\n    state (i) {\n      if (this.r.coordinator !== 'online' || this.r.target !== 'both') return 'off'\n      return (this.r.real || [])[i] || 'pending'\n    }\n  }\n}\n</script>\n\n<style>\n.wl-real .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }\n.wl-real .tile { background: #f5f7f6; border-radius: 12px; padding: 10px 12px; }\n.wl-real .num { font-size: 26px; font-weight: 700; color: #2f7a5c; line-height: 1.1; }\n.wl-real .act { font-size: 12px; color: #5d6b64; min-height: 32px; }\n.wl-real .st { display: inline-block; margin-top: 6px; padding: 2px 10px; border-radius: 999px; font-size: 11px; font-weight: 700;\n      text-transform: uppercase; background: #e4e9e6; color: #6f7c75; }\n.wl-real .tile.sent .st, .wl-real .tile.running .st { background: #fdf0d9; color: #b7791f; }\n.wl-real .tile.done { background: #e8f4ee; }\n.wl-real .tile.done .st { background: #2f7a5c; color: #fff; }\n.wl-real .tile.error { background: #fbe9e6; }\n.wl-real .tile.error .num { color: #c0392b; }\n.wl-real .tile.error .st { background: #c0392b; color: #fff; }\n.wl-real .tile.off { opacity: 0.45; }\n.wl-real .note { margin-top: 10px; font-size: 12px; color: #8a968f; }\n</style>",
