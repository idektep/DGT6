  {
    "id": "d7a0000000000024",
    "type": "ui-template",
    "z": "d7a0000000000001",
    "group": "d7a0000000000004",
    "page": "",
    "ui": "",
    "name": "Run",
    "order": 1,
    "width": "4",
    "height": "8",
    "head": "",
    "format": "<template>\n  <div class=\"tw tw-run\">\n    <p v-if=\"!online\" class=\"say warn\">The coordinator is offline. Start it on the PC with <code>python twin.py</code>.</p>\n    <div>\n      <div class=\"cap\" id=\"tw-shelf-cap\">Store the box on</div>\n      <div class=\"rack\" role=\"radiogroup\" aria-labelledby=\"tw-shelf-cap\">\n        <button v-for=\"n in 6\" :key=\"n\" role=\"radio\" :aria-checked=\"w.shelf === n\" :class=\"{ on: w.shelf === n }\"\n                :disabled=\"!online || busy\" @click=\"say('shelf', n)\">Shelf {{ n }}</button>\n      </div>\n    </div>\n    <div>\n      <div class=\"cap\" id=\"tw-mode-cap\">How the cycle runs</div>\n      <div class=\"seg\" role=\"radiogroup\" aria-labelledby=\"tw-mode-cap\">\n        <button role=\"radio\" :aria-checked=\"w.mode === 'step'\" :class=\"{ on: w.mode === 'step' }\" :disabled=\"!online\"\n                @click=\"say('mode', 'step')\">Step by step</button>\n        <button role=\"radio\" :aria-checked=\"w.mode === 'full'\" :class=\"{ on: w.mode === 'full' }\" :disabled=\"!online\"\n                @click=\"say('mode', 'full')\">Full cycle</button>\n      </div>\n      <p class=\"muted\">{{ w.mode === 'full' ? 'Runs all 8 steps without pausing.' : 'Pauses after each step until you press Next step.' }}</p>\n    </div>\n    <div class=\"go\">\n      <button class=\"primary\" :disabled=\"!canStart\" @click=\"say('start')\">Start cycle</button>\n      <button :disabled=\"w.waitingFor !== 'user'\" @click=\"say('next')\">Next step</button>\n    </div>\n    <button class=\"stop big\" :disabled=\"!online\" @click=\"say('stop')\">Stop all machines</button>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    r () { return (this.msg && this.msg.payload) || {} },\n    online () { return this.r.coordinator === 'online' },\n    w () { return (this.online && this.r.work) || { shelf: 0, mode: '', waitingFor: '' } },\n    busy () { return this.w.waitingFor === 'device' },\n    canStart () { return this.online && ['start', 'error', 'stopped'].includes(this.w.waitingFor) }\n  },\n  methods: {\n    say (topic, payload) { this.send({ topic, payload: payload === undefined ? '' : payload }) }\n  }\n}\n</script>\n\n<style>\n.tw-run { display: flex; flex-direction: column; gap: 18px; }\n.tw-run .cap { font-size: 13px; color: var(--tw-muted); margin-bottom: 6px; }\n.tw-run .rack { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\n.tw-run .seg { display: grid; grid-template-columns: 1fr 1fr; }\n.tw-run .seg button:first-child { border-radius: 4px 0 0 4px; }\n.tw-run .seg button:last-child { border-radius: 0 4px 4px 0; margin-left: -1px; }\n.tw-run .seg button.on { position: relative; z-index: 1; }\n.tw-run .muted { margin: 6px 0 0; }\n.tw-run .go { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.tw-run .go button { padding: 12px 14px; }\n.tw-run button.big { padding: 16px; font-size: 17px; }\n</style>",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 640,
