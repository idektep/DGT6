    "format": "<template>\n  <div class=\"tw tw-conv\">\n    <p class=\"muted note\">Goes straight to the machine. Use it only when no cycle is running.</p>\n    <button class=\"primary\" @click=\"go('start')\">Run belt</button>\n    <button @click=\"go('auto')\">Run to the next box</button>\n    <button class=\"stop\" @click=\"go('stop')\">Stop belt</button>\n    <p class=\"muted\">{{ sent }}</p>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () { return { sent: '' } },\n  methods: {\n    go (cmd) {\n      this.send({ topic: 'dgt_conv/control', payload: { cmd } })\n      this.sent = { start: 'Belt running. It ignores the sensor.', auto: 'Belt runs until a box reaches the sensor.',\n                    stop: 'Belt stopped.' }[cmd]\n    }\n  }\n}\n</script>\n\n<style>\n.tw-conv { display: flex; flex-direction: column; gap: 8px; }\n.tw-conv .note { margin: 0 0 4px; }\n.tw-conv button { padding: 13px 14px; }\n.tw-conv p:last-child { margin: 0; min-height: 18px; }\n</style>",
