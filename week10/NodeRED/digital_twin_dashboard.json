    "height": "5",
    "head": "",
    "format": "<template>\n  <div class=\"tw tw-mach\">\n    <div class=\"bar\">\n      <span :class=\"['lamp', online ? 'ok' : 'bad']\" aria-hidden=\"true\"></span>\n      <span>{{ online ? 'Coordinator running' : 'Coordinator offline' }}</span>\n      <button class=\"primary\" :disabled=\"!online\" @click=\"check('all')\">Check all machines</button>\n    </div>\n    <ul class=\"grid\">\n      <li v-for=\"d in list\" :key=\"d.name\" :class=\"['m', conn(d)]\">\n        <div class=\"top\">\n          <span :class=\"['lamp', lamp(d)]\" aria-hidden=\"true\"></span>\n          <span class=\"name\">{{ d.label }}</span>\n        </div>\n        <dl>\n          <dt>Link</dt><dd :class=\"conn(d)\">{{ connText(d) }}</dd>\n          <dt>Doing</dt><dd>{{ stateText(d.state) }}</dd>\n          <dt>Ready</dt><dd :class=\"'r-' + readyClass(d.check)\">{{ readyText(d) }}</dd>\n          <dt>Heard</dt><dd class=\"num\">{{ d.seen || 'not yet' }}</dd>\n        </dl>\n        <p class=\"extra\">{{ extra(d) }}</p>\n        <button :disabled=\"!online || d.check === 'pending'\" @click=\"check(d.name)\">\n          {{ d.check === 'pending' ? 'Checking' : 'Check' }}</button>\n      </li>\n    </ul>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    r () { return (this.msg && this.msg.payload) || {} },\n    online () { return this.r.coordinator === 'online' },\n    list () {\n      const labels = { conveyor: 'Conveyor', arm2: 'Arm 2', agv: 'AGV', arm1: 'Arm 1', cartesian: 'Cartesian' }\n      const devices = this.r.devices || {}\n      return Object.keys(labels).map(name => Object.assign({ name, label: labels[name] }, devices[name] || {}))\n    }\n  },\n  methods: {\n    check (name) { this.send({ topic: 'check', payload: name }) },\n    conn (d) { return d.online === true ? 'online' : d.online === false ? 'offline' : 'unknown' },\n    connText (d) { return { online: 'Connected', offline: 'Not connected', unknown: 'No news yet' }[this.conn(d)] },\n    readyClass (c) { return c === 'ready' ? 'ok' : c === 'pending' ? 'wait' : c ? 'bad' : '' },\n    readyText (d) {\n      return { ready: 'Ready', 'not ready': 'Not ready', 'no reply': 'No answer', pending: 'Checking' }[d.check]\n        || 'Not checked'\n    },\n    lamp (d) {\n      if (d.online === false || d.check === 'no reply') return 'bad'\n      if (d.check === 'not ready' || (d.last && d.last.fault)) return 'warn'\n      return d.online ? 'ok' : ''\n    },\n    stateText (s) {\n      return { moving: 'Moving', running: 'Belt running', decelerating: 'Slowing down', waiting: 'Holding a box',\n        done: 'Finished a move', ready: 'Idle', manual_stop: 'Stopped', manual_run: 'Belt running',\n        stopped: 'Stopped', error: 'Reported an error', check: 'Answered a check', offline: 'Off' }[s] || s || 'Nothing yet'\n    },\n    extra (d) {\n      const l = d.last || {}\n      if (l.fault) return 'Stalled: the encoder stopped counting'\n      if (l.msg) return l.msg\n      if (Array.isArray(l.pose)) return 'Joints ' + l.pose.join(' / ')\n      if (l.item !== undefined) return l.item ? 'Box at the sensor' : 'No box at the sensor'\n      if (Array.isArray(l.travel_mm)) return 'Last move ' + l.travel_mm.map(v => Math.round(v)).join(' / ') + ' mm'\n      return ''\n    }\n  }\n}\n</script>\n\n<style>\n.tw-mach .bar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }\n.tw-mach .bar button { margin-left: auto; }\n.tw-mach .lamp { width: 12px; height: 12px; border-radius: 50%; background: var(--tw-line); flex: none; }\n.tw-mach .lamp.ok { background: var(--tw-run); }\n.tw-mach .lamp.warn { background: var(--tw-warn); }\n.tw-mach .lamp.bad { background: var(--tw-alarm); }\n.tw-mach .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\n  border: 1px solid var(--tw-line); border-radius: 6px; background: #fff; }\n.tw-mach .m { padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; border-left: 1px solid var(--tw-line); }\n.tw-mach .m:first-child { border-left: none; }\n.tw-mach .m.offline { background: var(--tw-alarm-soft); }\n.tw-mach .top { display: flex; align-items: center; gap: 8px; }\n.tw-mach .name { font: 600 18px var(--tw-head); }\n.tw-mach dl { display: grid; grid-template-columns: auto 1fr; gap: 3px 10px; margin: 0; font-size: 14px; }\n.tw-mach dt { color: var(--tw-muted); }\n.tw-mach dd { margin: 0; }\n.tw-mach dd.offline, .tw-mach dd.r-bad { color: var(--tw-alarm); font-weight: 600; }\n.tw-mach dd.online, .tw-mach dd.r-ok { color: var(--tw-run); font-weight: 600; }\n.tw-mach dd.r-wait { color: var(--tw-warn); }\n.tw-mach .num { font-variant-numeric: tabular-nums; }\n.tw-mach .extra { margin: 0; font-size: 13px; color: var(--tw-muted); min-height: 18px; }\n.tw-mach .m button { margin-top: auto; }\n@media (max-width: 900px) { .tw-mach .m { border-left: none; border-top: 1px solid var(--tw-line); }\n  .tw-mach .m:first-child { border-top: none; } }\n</style>",
