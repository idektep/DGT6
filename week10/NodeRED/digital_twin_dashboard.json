             locked: null, loaded: false, progress: null } },\n  watch: {\n    msg: {\n      immediate: true,\n      handler (m) {\n        const p = m && m.payload\n        if (!p) return\n        if (p.coordinator === undefined) { this.progress = p; return }\n        this.locked = p.coordinator === 'online' && p.sequence ? p.sequence[this.device] : null\n        if (this.locked && !this.loaded) { this.loadLocked(); this.loaded = true }\n      }\n    }\n  },\n  methods: {\n    run (action) {\n      const pose = action === 'pick' ? this.pick : this.place\n      const grip = action === 'pick' ? this.gripOn : this.gripOff\n      this.send({ topic: 'seq', payload: { arm: 'arm1', action, pose: pose.slice(), grip, open: this.gripOff } })\n    },\n    stop () { this.send({ topic: 'seq', payload: { arm: 'arm1', action: 'stop' } }) },\n    lock () {\n      this.send({ topic: 'lock', payload: { device: 'arm1', pick: this.pick.slice(), place: this.place.slice(),\n                                           grip_on: this.gripOn, grip_off: this.gripOff } })\n    },\n    loadLocked () {\n      this.pick = this.locked.pick.slice(); this.place = this.locked.place.slice()\n      this.gripOn = this.locked.grip_on; this.gripOff = this.locked.grip_off\n    }\n  }\n}\n</script>\n\n<style>\n.tw-arm { display: flex; flex-direction: column; gap: 12px; }\n.tw-arm .note { margin: 0; }\n.tw-arm .poses { display: grid; grid-template-columns: 70px repeat(4, minmax(0, 1fr)) 84px; gap: 6px 6px; align-items: center; }\n.tw-arm .j { font-size: 13px; color: var(--tw-muted); text-align: center; }\n.tw-arm .what { font-size: 14px; font-weight: 500; }\n.tw-arm .grip { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: end; }\n.tw-arm .say { margin: 0; }\n.tw-arm .lock { align-self: flex-start; }\n@media (max-width: 520px) { .tw-arm .grip { grid-template-columns: 1fr 1fr; } .tw-arm .grip button { grid-column: span 2; } }\n</style>",
