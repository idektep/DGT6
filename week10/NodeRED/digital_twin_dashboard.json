  {
    "id": "d7a0000000000020",
    "type": "ui-template",
    "z": "d7a0000000000001",
    "group": "",
    "page": "d7a0000000000003",
    "ui": "",
    "name": "Page style",
    "order": 0,
    "width": "0",
    "height": "0",
    "head": "",
    "format": "@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Semi+Condensed:wght@500;600&display=swap');\n\n/* Digital twin operator screen. Colour means machine state only:\n   run = running / ready, warn = needs the operator, alarm = fault or stop, steel = selection / current step. */\n:root {\n  --tw-canvas: #E6E9EC; --tw-panel: #F8F9FA; --tw-ink: #1D2830; --tw-muted: #66727C; --tw-line: #CDD3D8;\n  --tw-steel: #2A5C88; --tw-steel-soft: #DCE6EF; --tw-run: #1F8A5B; --tw-warn: #B97A0B; --tw-warn-soft: #F6ECD6;\n  --tw-alarm: #C4342C; --tw-alarm-soft: #F6DEDC;\n  --tw-font: \"Barlow\", \"Segoe UI\", system-ui, sans-serif;\n  --tw-head: \"Barlow Semi Condensed\", \"Barlow\", \"Segoe UI\", system-ui, sans-serif;\n}\n.v-application { font-family: var(--tw-font) !important; color: var(--tw-ink); background: var(--tw-canvas) !important; }\n.v-app-bar { background: var(--tw-ink) !important; color: #fff !important; box-shadow: none !important; }\n.v-app-bar .v-toolbar-title { font-family: var(--tw-head); font-weight: 600; letter-spacing: 0; }\n.nrdb-ui-group > .v-card { background: var(--tw-panel) !important; border: 1px solid var(--tw-line) !important;\n  border-radius: 8px !important; box-shadow: none !important; }\n.nrdb-ui-group .v-card-title, .nrdb-ui-group h4 { font-family: var(--tw-head) !important; font-weight: 600 !important;\n  font-size: 18px !important; color: var(--tw-ink); letter-spacing: 0 !important; }\n\n/* shared controls */\n.tw { font-size: 15px; line-height: 1.45; color: var(--tw-ink); }\n.tw *, .tw *::before, .tw *::after { box-sizing: border-box; }\n.tw button { font: 600 15px/1 var(--tw-font); border: 1px solid var(--tw-line); background: #fff; color: var(--tw-ink);\n  border-radius: 4px; padding: 9px 14px; cursor: pointer; }\n.tw button:hover:not(:disabled) { border-color: var(--tw-muted); }\n.tw button:disabled { opacity: .45; cursor: not-allowed; }\n.tw button:focus-visible, .tw input:focus-visible { outline: 2px solid var(--tw-steel); outline-offset: 2px; }\n.tw button.primary { background: var(--tw-steel); border-color: var(--tw-steel); color: #fff; }\n.tw button.stop { background: var(--tw-alarm); border-color: var(--tw-alarm); color: #fff; }\n.tw button.on { background: var(--tw-steel-soft); border-color: var(--tw-steel); color: var(--tw-steel); }\n.tw button.on:disabled { opacity: 1; }   /* the chosen shelf stays readable while a cycle runs */\n.tw input { font: 500 15px var(--tw-font); width: 100%; min-width: 0; padding: 7px 8px; border: 1px solid var(--tw-line);\n  border-radius: 4px; background: #fff; color: var(--tw-ink); font-variant-numeric: tabular-nums; }\n.tw label { font-size: 13px; color: var(--tw-muted); display: flex; flex-direction: column; gap: 3px; }\n.tw .muted { color: var(--tw-muted); font-size: 13px; }\n.tw code { font-family: inherit; background: var(--tw-canvas); padding: 1px 6px; border-radius: 4px; }\n.tw .say { font-size: 13px; padding: 7px 10px; border-radius: 4px; background: var(--tw-canvas); color: var(--tw-ink); }\n.tw .say.ok { color: var(--tw-run); }\n.tw .say.warn { background: var(--tw-warn-soft); color: #7A5206; }\n.tw .say.error { background: var(--tw-alarm-soft); color: var(--tw-alarm); font-weight: 600; }\n.tw .lockbox { border-top: 1px solid var(--tw-line); padding-top: 12px; margin-top: 4px; display: flex; flex-direction: column; gap: 8px; }\n.tw .lockbox p { margin: 0; font-size: 13px; color: var(--tw-muted); }\n.tw .lockbox b { color: var(--tw-ink); font-weight: 600; }\n",
