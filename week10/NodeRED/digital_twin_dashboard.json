  {
    "id": "d7a0000000000045",
    "type": "function",
    "z": "d7a0000000000001",
    "name": "Arm pick/place sequence",
    "func": "// Pick / place for one arm, built from the arm's basic commands (each waits for \"done\"):\n//   0. pick only: {\"cmd\":\"joint\",\"joint\":5,\"value\":open}   open the gripper first\n//   1. {\"cmd\":\"move\",\"value\":[J1,J2,J3,J4,-1]}   (-1 = keep J5)\n//   2. {\"cmd\":\"joint\",\"joint\":5,\"value\":grip}    gripper on (pick) / off (place)\n//   3. wait 2 s, then report finished\n// Inputs: msg.topic \"seq\" from the arm panels, or an arm status (dgt_rba1/status, dgt_rba2/status)\n// Outputs: 1 -> MQTT (msg.topic = arm control topic), 2 -> Arm 1 panel, 3 -> Arm 2 panel\nconst PREFIX = { arm1: 'dgt_rba1', arm2: 'dgt_rba2' };\nconst GRIP_WAIT_MS = 2000;\nconst KEEP = -1;\n\nconst seqs = context.get('seqs') || {};\nconst save = () => context.set('seqs', seqs);\nconst command = (arm, payload) => ({ topic: PREFIX[arm] + '/control', payload });\nconst word = action => action === 'pick' ? 'Pick' : 'Place';\nconst progress = (arm, text, level) => {\n    const out = [null, null, null];\n    out[arm === 'arm1' ? 1 : 2] = { payload: { text, level: level || 'info', time: new Date().toLocaleTimeString() } };\n    return out;\n};\nconst withCommand = (arm, payload, text, level) => {\n    const out = progress(arm, text, level);\n    out[0] = command(arm, payload);\n    return out;\n};\n\n// ---- from a panel button\nif (msg.topic === 'seq') {\n    const p = msg.payload || {};\n    const arm = p.arm;\n    if (!PREFIX[arm]) return null;\n    if (p.action === 'stop') {\n        delete seqs[arm]; save();\n        return withCommand(arm, { cmd: 'stop' }, 'Arm stopped.', 'error');\n    }\n    if (seqs[arm]) return progress(arm, word(seqs[arm].action) + ' is still running. Press Stop arm first.', 'warn');\n    const pose = (p.pose || []).map(Number);\n    const grip = Number(p.grip);\n    const open = Number(p.open);\n    if (pose.length !== 4 || pose.some(isNaN) || isNaN(grip) || (p.action === 'pick' && isNaN(open))) {\n        return progress(arm, 'Fill in J1 to J4 and the gripper angles.', 'warn');\n    }\n    if (p.action === 'pick') {   // the gripper may still be closed (power-up HOME closes it)\n        seqs[arm] = { action: p.action, phase: 'open', pose, grip };\n        save();\n        return withCommand(arm, { cmd: 'joint', joint: 5, value: open }, 'Pick: opening the gripper (' + open + '°)');\n    }\n    seqs[arm] = { action: p.action, phase: 'move', pose, grip };\n    save();\n    return withCommand(arm, { cmd: 'move', value: pose.concat([KEEP]) }, 'Place: moving to ' + pose.join(' / '));\n}\n\n// ---- arm status\nconst arm = Object.keys(PREFIX).find(a => msg.topic === PREFIX[a] + '/status');\nconst s = arm && seqs[arm];\nconst state = msg.payload && msg.payload.state;\nif (!s) return null;\nif (state === 'error' || state === 'stopped' || state === 'offline') {\n    delete seqs[arm]; save();\n    return progress(arm, word(s.action) + ' failed: ' + (msg.payload.msg || state), 'error');\n}\nif (state !== 'done') return null;\n\nif (s.phase === 'open') {\n    s.phase = 'move'; save();\n    return withCommand(arm, { cmd: 'move', value: s.pose.concat([KEEP]) }, 'Pick: moving to ' + s.pose.join(' / '));\n}\nif (s.phase === 'move') {\n    s.phase = 'grip'; save();\n    return withCommand(arm, { cmd: 'joint', joint: 5, value: s.grip },\n                       word(s.action) + ': gripper ' + (s.action === 'pick' ? 'on' : 'off') + ' (' + s.grip + '°)');\n}\nif (s.phase === 'grip') {\n    s.phase = 'wait'; save();\n    setTimeout(() => {\n        const now = context.get('seqs') || {};\n        if (now[arm] !== s) return;           // stopped meanwhile\n        delete now[arm]; context.set('seqs', now);\n        node.send(progress(arm, word(s.action) + ' finished.', 'ok'));\n    }, GRIP_WAIT_MS);\n    return progress(arm, word(s.action) + ': waiting 2 s');\n}\nreturn null;",
    "outputs": 3,
