  {
    "id": "d7a0000000000022",
    "type": "ui-template",
    "z": "d7a0000000000001",
    "group": "d7a0000000000006",
    "page": "",
    "ui": "",
    "name": "Cycle progress",
    "order": 1,
    "width": "8",
    "height": "8",
    "head": "",
    "format": "<template>\n  <div class=\"tw tw-cycle\">\n    <template v-if=\"w\">\n      <div class=\"now\">\n        <h3 :class=\"['ask', w.waitingFor]\">{{ headline }}</h3>\n        <span class=\"count\">{{ w.cycles === 1 ? '1 box stored' : w.cycles + ' boxes stored' }} this session</span>\n      </div>\n      <p v-if=\"doing\" class=\"cmd\">{{ w.waitingFor === 'error' ? 'Stuck at' : 'Now' }}: {{ doing }}</p>\n      <p v-if=\"w.message && w.message.text && w.message.level !== 'info'\" :class=\"['say', w.message.level]\">\n        {{ w.message.time }}&nbsp; {{ w.message.text }}</p>\n      <ol class=\"line\">\n        <li v-for=\"(s, i) in w.steps\" :key=\"i\" :class=\"['node', s.status || 'pending', { current: i + 1 === w.step }]\"\n            :aria-current=\"i + 1 === w.step ? 'step' : null\">\n          <span class=\"dot\">{{ i + 1 }}</span>\n          <span class=\"who\">{{ label(i).who }}</span>\n          <span class=\"what\">{{ label(i).what }}</span>\n          <span class=\"st\">{{ statusText(s.status) }}</span>\n        </li>\n      </ol>\n    </template>\n    <p v-else class=\"say warn\">The coordinator is offline, so there is no cycle to show. Start it on the PC with <code>python twin.py</code>.</p>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    w () {\n      const p = (this.msg && this.msg.payload) || {}\n      return p.coordinator === 'online' ? p.work : null\n    },\n    headline () {\n      const w = this.w\n      const step = this.label(w.step - 1)\n      const what = step.what ? step.what[0].toLowerCase() + step.what.slice(1) : ''\n      return {\n        start: 'Ready. Choose a shelf and start a cycle.',\n        device: 'Step ' + w.step + ' of 8: ' + step.who + ' ' + what,\n        user: 'Step ' + w.step + ' finished. Press Next step to continue.',\n        error: 'Step ' + w.step + ' failed. Start runs the cycle again from step 1.',\n        stopped: 'All machines stopped. Start runs a new cycle from step 1.',\n      }[w.waitingFor] || ''\n    },\n    doing () {   // the coordinator's current command, in plain words\n      const it = this.w && this.w.item\n      if (!it) return ''\n      if (it.wait !== undefined) return 'waiting ' + it.wait + ' s for the gripper'\n      const who = { agv: 'AGV', arm1: 'arm 1', arm2: 'arm 2', conveyor: 'conveyor', cartesian: 'cartesian' }[it.to] || it.to\n      const c = it.cmd || {}\n      const agv = { f: 'forward', b: 'back', l: 'left', r: 'right', cw: 'turn right', ccw: 'turn left' }\n      if (c.cmd === 'move') return who + ' moves to ' + c.value.slice(0, 4).join(' / ')\n      if (c.cmd === 'joint') return who + ' sets the gripper to ' + c.value + '°'\n      if (c.cmd === 'step') return 'conveyor runs to the next box'\n      if (c.cmd === 'store') return 'cartesian stores the box on shelf ' + c.shelf\n      if (c.cmd === 'home') return who + ' goes home'\n      if (agv[c.cmd]) return 'AGV ' + agv[c.cmd] + ' ' + c.value + (c.cmd.indexOf('cw') >= 0 ? '°' : ' mm')\n      return who + ': ' + c.cmd\n    }\n  },\n  methods: {\n    label (i) {\n      const shelf = this.w ? this.w.shelf : ''\n      return [\n        { who: 'Conveyor', what: 'Brings the box to arm 2' },\n        { who: 'Arm 2', what: 'Picks the box' },\n        { who: 'Arm 2', what: 'Loads the AGV' },\n        { who: 'AGV', what: 'Drives to arm 1' },\n        { who: 'Arm 1', what: 'Picks the box' },\n        { who: 'Arm 1', what: 'Hands it to the cartesian' },\n        { who: 'Cartesian', what: 'Stores it on shelf ' + shelf },\n        { who: 'AGV and cartesian', what: 'Return home' },\n      ][i] || { who: '', what: '' }\n    },\n    statusText (s) {\n      return { running: 'Running', done: 'Done', error: 'Failed', stopped: 'Stopped' }[s] || 'Waiting'\n    }\n  }\n}\n</script>\n\n<style>\n.tw-cycle .now { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }\n.tw-cycle .ask { font: 600 24px/1.2 var(--tw-head); margin: 0; flex: 1; min-width: 260px; color: var(--tw-ink); }\n.tw-cycle .ask.user { color: var(--tw-warn); }\n.tw-cycle .ask.error, .tw-cycle .ask.stopped { color: var(--tw-alarm); }\n.tw-cycle .count { font-size: 13px; color: var(--tw-muted); font-variant-numeric: tabular-nums; }\n.tw-cycle .cmd { margin: 8px 0 0; font-size: 13px; color: var(--tw-muted); }\n.tw-cycle .say { margin: 10px 0 0; }\n\n/* the process line */\n.tw-cycle .line { list-style: none; margin: 22px 0 4px; padding: 0; display: grid; grid-template-columns: repeat(8, 1fr); }\n.tw-cycle .node { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center;\n  padding: 0 4px; gap: 2px; }\n.tw-cycle .node::before { content: \"\"; position: absolute; top: 17px; right: 50%; width: 100%; height: 3px;\n  background: var(--tw-line); z-index: 0; }\n.tw-cycle .node:first-child::before { display: none; }\n.tw-cycle .node.done::before, .tw-cycle .node.running::before, .tw-cycle .node.current::before { background: var(--tw-ink); }\n.tw-cycle .dot { position: relative; z-index: 1; width: 37px; height: 37px; border-radius: 50%; display: grid; place-items: center;\n  font: 600 16px var(--tw-head); background: var(--tw-panel); border: 3px solid var(--tw-line); color: var(--tw-muted);\n  margin-bottom: 6px; font-variant-numeric: tabular-nums; }\n.tw-cycle .node.done .dot { background: var(--tw-ink); border-color: var(--tw-ink); color: #fff; }\n.tw-cycle .node.running .dot { background: var(--tw-steel); border-color: var(--tw-steel); color: #fff; }\n.tw-cycle .node.current:not(.running):not(.error):not(.stopped) .dot { border-color: var(--tw-warn); color: var(--tw-warn); }\n.tw-cycle .node.error .dot, .tw-cycle .node.stopped .dot { background: var(--tw-alarm); border-color: var(--tw-alarm); color: #fff; }\n.tw-cycle .who { font: 600 14px/1.2 var(--tw-head); }\n.tw-cycle .what { font-size: 13px; line-height: 1.3; color: var(--tw-muted); }\n.tw-cycle .st { margin-top: 4px; font-size: 12px; color: var(--tw-muted); }\n.tw-cycle .node.running .st { color: var(--tw-steel); font-weight: 600; }\n.tw-cycle .node.error .st, .tw-cycle .node.stopped .st { color: var(--tw-alarm); font-weight: 600; }\n@media (prefers-reduced-motion: no-preference) {\n  .tw-cycle .node.running .dot { animation: tw-pulse 1.6s ease-out infinite; }\n  @keyframes tw-pulse { 0% { box-shadow: 0 0 0 0 rgba(42, 92, 136, .45); } 100% { box-shadow: 0 0 0 12px rgba(42, 92, 136, 0); } }\n}\n/* narrow screens: the line runs down the page */\n@media (max-width: 760px) {\n  .tw-cycle .line { grid-template-columns: 1fr; gap: 14px; }\n  .tw-cycle .node { display: grid; grid-template-columns: 37px 1fr auto; column-gap: 12px; text-align: left; align-items: center; padding: 0; }\n  .tw-cycle .node::before { top: auto; bottom: 100%; right: auto; left: 17px; width: 3px; height: 14px; }\n  .tw-cycle .dot { grid-row: span 2; margin: 0; }\n  .tw-cycle .st { grid-row: 1 / span 2; grid-column: 3; margin: 0; }\n}\n</style>",
