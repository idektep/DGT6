    "name": "Manual AGV",
    "order": 1,
    "width": "8",
    "height": "7",
    "head": "",
    "format": "<template>\n  <div class=\"tw tw-agv\">\n    <p class=\"muted note\">Goes straight to the machine. Use it only when no cycle is running.</p>\n    <div class=\"body\">\n      <div class=\"pad\" role=\"group\" aria-label=\"Jog the AGV\">\n        <button @click=\"go('ccw', angle)\" title=\"Turn left (counter-clockwise)\">&#10226; Turn left</button>\n        <button class=\"primary\" @click=\"go('f', dist)\">&#8593; Forward</button>\n        <button @click=\"go('cw', angle)\" title=\"Turn right (clockwise)\">Turn right &#10227;</button>\n        <button @click=\"go('l', dist)\">&#8592; Left</button>\n        <button class=\"stop\" @click=\"go('s')\">Stop</button>\n        <button @click=\"go('r', dist)\">Right &#8594;</button>\n        <span></span>\n        <button @click=\"go('b', dist)\">&#8595; Back</button>\n        <span></span>\n      </div>\n      <div class=\"set\">\n        <label>Distance, mm<input type=\"number\" v-model.number=\"dist\" min=\"1\"></label>\n        <label>Turn, degrees<input type=\"number\" v-model.number=\"angle\" min=\"1\"></label>\n        <label>Speed, mm/s<input type=\"number\" v-model.number=\"speed\" min=\"1\"></label>\n        <button @click=\"go('v', speed)\">Set speed</button>\n      </div>\n    </div>\n    <p class=\"muted sent\">{{ sent }}</p>\n    <div class=\"lockbox\">\n      <p>Moves since you last cleared: <b>{{ recorded.length ? words(recorded) : 'none yet' }}</b></p>\n      <div class=\"row\">\n        <button class=\"primary\" :disabled=\"!recorded.length\" @click=\"lock()\">Lock route for step 4</button>\n        <button :disabled=\"!recorded.length\" @click=\"recorded = []\">Clear moves</button>\n      </div>\n      <p v-if=\"locked\">Locked route: <b>{{ words(locked.route) }}</b> at <b>{{ locked.speed }} mm/s</b>.\n        Step 8 drives it in reverse to come home.</p>\n      <p v-else>Locked route shows here once the coordinator is running.</p>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () { return { device: 'agv', dist: 300, angle: 90, speed: 150, recorded: [], locked: null, loaded: false,\n                     progress: null, sent: '' } },\n  watch: {\n    msg: {\n      immediate: true,\n      handler (m) {\n        const p = m && m.payload\n        if (!p) return\n        if (p.coordinator === undefined) { this.progress = p; return }\n        this.locked = p.coordinator === 'online' && p.sequence ? p.sequence[this.device] : null\n        if (this.locked && !this.loaded) { this.loadLocked(); this.loaded = true }\n      }\n    }\n  },\n  methods: {\n    go (cmd, value) {\n      if (value !== undefined && !(value > 0)) { this.sent = 'Enter a number above 0 first.'; return }\n      const payload = value === undefined ? { cmd } : { cmd, value }\n      this.send({ topic: 'dgt_agv/control', payload })\n      if (['f', 'b', 'l', 'r', 'cw', 'ccw'].includes(cmd)) this.recorded.push(payload)\n      this.sent = 'Sent: ' + this.words([payload])\n    },\n    lock () {\n      this.send({ topic: 'lock', payload: { device: 'agv', route: this.recorded.slice(), speed: this.speed } })\n      this.sent = 'Lock sent. The locked route below updates when the coordinator saves it.'\n    },\n    loadLocked () { this.speed = this.locked.speed },\n    words (route) {\n      const name = { f: 'forward', b: 'back', l: 'left', r: 'right', cw: 'turn right', ccw: 'turn left', v: 'speed', s: 'stop' }\n      const unit = { cw: '°', ccw: '°', v: ' mm/s' }\n      return route.map(m => name[m.cmd] + (m.value !== undefined ? ' ' + m.value + (unit[m.cmd] || ' mm') : '')).join(', ')\n        || 'no moves'\n    }\n  }\n}\n</script>\n\n<style>\n.tw-agv { display: flex; flex-direction: column; gap: 10px; }\n.tw-agv .note { margin: 0; }\n.tw-agv .body { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 18px; align-items: start; }\n.tw-agv .pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\n.tw-agv .pad button { padding: 14px 6px; }\n.tw-agv .set { display: grid; gap: 10px; }\n.tw-agv .sent { margin: 0; min-height: 18px; }\n.tw-agv .row { display: flex; gap: 8px; flex-wrap: wrap; }\n@media (max-width: 640px) { .tw-agv .body { grid-template-columns: 1fr; } }\n</style>",
