    "format": "<template>\n  <div class=\"tw tw-arm\">\n    <p class=\"muted note\">Arm 2 picks from the conveyor and loads the AGV. Goes straight to the arm. Use it only when no cycle is running.</p>\n    <div class=\"poses\">\n      <span></span><span class=\"j\">J1</span><span class=\"j\">J2</span><span class=\"j\">J3</span><span class=\"j\">J4</span><span></span>\n      <span class=\"what\">Pick at</span>\n      <input v-for=\"(v, i) in pick\" :key=\"'p' + i\" type=\"number\" v-model.number=\"pick[i]\" :aria-label=\"'Pick J' + (i + 1)\">\n      <button class=\"primary\" @click=\"run('pick')\">Pick</button>\n      <span class=\"what\">Place at</span>\n      <input v-for=\"(v, i) in place\" :key=\"'q' + i\" type=\"number\" v-model.number=\"place[i]\" :aria-label=\"'Place J' + (i + 1)\">\n      <button class=\"primary\" @click=\"run('place')\">Place</button>\n    </div>\n    <div class=\"grip\">\n      <label>Gripper on (grab), deg<input type=\"number\" v-model.number=\"gripOn\"></label>\n      <label>Gripper off (release), deg<input type=\"number\" v-model.number=\"gripOff\"></label>\n      <button class=\"stop\" @click=\"stop()\">Stop arm</button>\n    </div>\n    <p :class=\"['say', progress ? progress.level : '']\">{{ progress ? progress.time + '  ' + progress.text : 'Pick: open gripper, move, gripper on, wait 2 s. Place: move, gripper off, wait 2 s.' }}</p>\n    <div class=\"lockbox\">\n      <button class=\"primary lock\" @click=\"lock()\">Lock these values for the cycle</button>\n      <p v-if=\"locked\">Locked: pick at <b>{{ locked.pick.join(' / ') }}</b>, place at <b>{{ locked.place.join(' / ') }}</b>,\n        gripper on <b>{{ locked.grip_on }}°</b>, off <b>{{ locked.grip_off }}°</b>.</p>\n      <p v-else>Locked values show here once the coordinator is running.</p>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data () { return { device: 'arm2', pick: [50, 85, 125, 75], place: [130, 85, 125, 75], gripOn: 20, gripOff: 90,\n                     locked: null, loaded: false, progress: null } },\n  watch: {\n    msg: {\n      immediate: true,\n      handler (m) {\n        const p = m && m.payload\n        if (!p) return\n        if (p.coordinator === undefined) { this.progress = p; return }\n        this.locked = p.coordinator === 'online' && p.sequence ? p.sequence[this.device] : null\n        if (this.locked && !this.loaded) { this.loadLocked(); this.loaded = true }\n      }\n    }\n  },\n  methods: {\n    run (action) {\n      const pose = action === 'pick' ? this.pick : this.place\n      const grip = action === 'pick' ? this.gripOn : this.gripOff\n      this.send({ topic: 'seq', payload: { arm: 'arm2', action, pose: pose.slice(), grip, open: this.gripOff } })\n    },\n    stop () { this.send({ topic: 'seq', payload: { arm: 'arm2', action: 'stop' } }) },\n    lock () {\n      this.send({ topic: 'lock', payload: { device: 'arm2', pick: this.pick.slice(), place: this.place.slice(),\n                                           grip_on: this.gripOn, grip_off: this.gripOff } })\n    },\n    loadLocked () {\n      this.pick = this.locked.pick.slice(); this.place = this.locked.place.slice()\n      this.gripOn = this.locked.grip_on; this.gripOff = this.locked.grip_off\n    }\n  }\n}\n</script>\n\n<style>\n.tw-arm { display: flex; flex-direction: column; gap: 12px; }\n.tw-arm .note { margin: 0; }\n.tw-arm .poses { display: grid; grid-template-columns: 70px repeat(4, minmax(0, 1fr)) 84px; gap: 6px 6px; align-items: center; }\n.tw-arm .j { font-size: 13px; color: var(--tw-muted); text-align: center; }\n.tw-arm .what { font-size: 14px; font-weight: 500; }\n.tw-arm .grip { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: end; }\n.tw-arm .say { margin: 0; }\n.tw-arm .lock { align-self: flex-start; }\n@media (max-width: 520px) { .tw-arm .grip { grid-template-columns: 1fr 1fr; } .tw-arm .grip button { grid-column: span 2; } }\n</style>",
